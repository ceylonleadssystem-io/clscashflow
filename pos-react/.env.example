# ---------------------------------------------------------------------------
# Ceylonry POS (React) - environment variables
# Copy to .env.local and adjust. Only VITE_* variables reach the browser, so
# NEVER put secrets (Appwrite API key, SMTP passwords) in this file.
# ---------------------------------------------------------------------------

# Authentication / cloud provider: "appwrite" (production) or "local"
# (offline/dev mode - owner e-mail + password hash stored on this device).
VITE_AUTH_PROVIDER=appwrite

# Appwrite (public identifiers only - same project the original POS used)
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a947d6e0012c551dfde

# Serverless document API that fronts the Appwrite database with the
# server-only API key (Netlify function in the main repository).
VITE_DOCS_FUNCTION_URL=/.netlify/functions/appwrite-docs
# Where `vite dev` forwards /.netlify/functions/* (run `netlify dev` there).
VITE_FUNCTIONS_PROXY=http://localhost:8888

# Other Netlify function integration points used by the POS
VITE_ONBOARDING_EMAIL_URL=/.netlify/functions/pos-onboarding-email

# Shared platform script (billing widget, paywall, support widget, EmailJS
# receipt sender). Served from public/assets/platform.js by default.
VITE_PLATFORM_SCRIPT_URL=/assets/platform.js

# Account that is redirected to the developer/support portal after sign-in
VITE_DEVELOPER_EMAIL=devteam@ceylonrylabs.io
# Link used by "Open Admin Portal" (support code section in Settings)
VITE_SUPPORT_PORTAL_URL=/pos-system/pos-admin.html
# Landing page / onboarding links shown on the sign-in gate
VITE_HOME_URL=/index.html
VITE_ONBOARDING_URL=/pos-onboarding.html

# Default EmailJS receipt configuration (overridable per business in settings)
VITE_EJS_KEY=gCD6W70FKqiN2ATlp
VITE_EJS_SERVICE=service_uneb8lv
VITE_EJS_RECEIPT_TEMPLATE=template_avm444n
# Template used for ORDER e-mails (body: {{{message_html}}}, see public/email-templates/pos-order-email.html).
# Empty = reuse the receipt template id above.
VITE_EJS_ORDER_TEMPLATE=

# Optional: catalogue photo bundle (window.CLS_AZURE_SWIM_IMAGES) - large file
# that is NOT copied into this project. Leave empty to skip.
VITE_CATALOGUE_IMAGES_URL=

# Cloud sync cadence (milliseconds)
VITE_SYNC_PULL_MS=1500
VITE_SYNC_PUSH_MS=2500

# Build base path (use "/pos-system/" when hosting beside the legacy pages)
VITE_BASE_PATH=/
