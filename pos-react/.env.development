# ---------------------------------------------------------------------------
# Shared developer setup - read ONLY by `npm run dev` (Vite "development" mode).
# Production builds (`vite build`, Netlify) never read this file; production values come
# from Netlify > Environment variables. Public identifiers only - never put secrets here.
# Personal overrides go in .env.local (git-ignored), which wins over this file.
# ---------------------------------------------------------------------------

# Local mode: sign in on this device, no cloud account needed (also enables the print preview)
VITE_AUTH_PROVIDER=local

# Where `vite dev` forwards /.netlify/functions/* (run `netlify dev` there)
VITE_FUNCTIONS_PROXY=http://localhost:8888
VITE_DOCS_FUNCTION_URL=/.netlify/functions/appwrite-docs
VITE_ONBOARDING_EMAIL_URL=/.netlify/functions/pos-onboarding-email
VITE_PLATFORM_SCRIPT_URL=/assets/platform.js

VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a947d6e0012c551dfde

VITE_DEVELOPER_EMAIL=devteam@ceylonrylabs.io
VITE_ADMIN_EMAILS=devteam@ceylonrylabs.io
VITE_SUPPORT_PORTAL_URL=/posv2/admin
VITE_HOME_URL=/index.html
VITE_ONBOARDING_URL=/pos-onboarding.html
VITE_ADMIN_FUNCTION_URL=/.netlify/functions/pos-admin-data
VITE_SEND_INVOICE_URL=/.netlify/functions/send-invoice

# EmailJS (order e-mails use the order template; see docs/emailjs-order-template.md)
VITE_EJS_KEY=gCD6W70FKqiN2ATlp
VITE_EJS_SERVICE=service_uneb8lv
VITE_EJS_RECEIPT_TEMPLATE=template_avm444n
VITE_EJS_ORDER_TEMPLATE=template_n075v8g

VITE_SYNC_PULL_MS=1500
VITE_SYNC_PUSH_MS=2500
VITE_BASE_PATH=/

# Local dev administrator (only used with VITE_AUTH_PROVIDER=local)
VITE_DEV_ADMIN_EMAIL=admin@ceylonry.local
VITE_DEV_ADMIN_PASSWORD=Admin#12345
